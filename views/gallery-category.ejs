<!doctype html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<main>

  <section class="page-banner">
    <div class="page-banner__bg">
      <img src="<%= category.heroImage %>" alt="<%= category.name %> renovation gallery">
    </div>
    <div class="container">
      <div class="page-banner__content">
        <div class="breadcrumbs"><a href="/">Home</a> <span>/</span> <a href="/gallery">Gallery</a> <span>/</span> <span><%= category.name %></span></div>
        <h1><%= category.name %> Gallery</h1>
        <p><%= category.tagline %></p>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="category-pills">
        <% Object.values(categories).forEach(function(cat) { %>
          <a href="/gallery/<%= cat.slug %>" class="category-pill <%= cat.slug === category.slug ? 'is-active' : '' %>"><%= cat.name %></a>
        <% }); %>
      </div>

      <div class="product-grid reveal-stagger">
        <% category.products.forEach(function(product) { %>
        <div class="card product-card">
          <div class="product-card__media">
            <img src="<%= product.image %>" alt="<%= product.name %>" loading="lazy">
          </div>
          <div class="product-card__body">
            <h3><%= product.name %></h3>
            <p><%= product.description %></p>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <section class="section-primary">
    <div class="container text-center reveal">
      <h2 style="color:#fff; margin-bottom: var(--space-4);">Like what you see?</h2>
      <p style="color:rgba(255,255,255,0.85); max-width:560px; margin-inline:auto; margin-bottom: var(--space-6);">Let's design something just as beautiful for your home.</p>
      <a href="/contact" class="btn btn--light">Start Your Project</a>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
