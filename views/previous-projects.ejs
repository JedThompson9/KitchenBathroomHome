<!doctype html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<main>

  <section class="page-banner">
    <div class="page-banner__bg">
      <img src="<%= previousProjects[0].image %>" alt="Completed bathroom, kitchen and laundry renovations">
    </div>
    <div class="container">
      <div class="page-banner__content">
        <div class="breadcrumbs"><a href="/">Home</a> <span>/</span> <span>Previous Projects</span></div>
        <h1>Previous Projects</h1>
        <p>A look at some of the bathrooms, kitchens and laundries we've fitted out for Brisbane homeowners.</p>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="category-pills">
        <a href="#" class="category-pill is-active" data-filter-pill="all">All Projects</a>
        <a href="#" class="category-pill" data-filter-pill="bathroom">Bathrooms</a>
        <a href="#" class="category-pill" data-filter-pill="kitchen">Kitchens</a>
        <a href="#" class="category-pill" data-filter-pill="laundry">Laundries</a>
      </div>

      <div class="product-grid reveal-stagger">
        <% previousProjects.forEach(function(project) { %>
        <div class="card product-card" data-product-category="<%= project.room %>">
          <div class="product-card__media">
            <img src="<%= project.image %>" alt="<%= project.title %>" loading="lazy">
          </div>
          <div class="product-card__body">
            <span class="project-card__tag"><%= project.room.charAt(0).toUpperCase() + project.room.slice(1) %> &middot; <%= project.location %></span>
            <h3><%= project.title %></h3>
            <p><%= project.description %></p>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <section class="section-primary">
    <div class="container text-center reveal">
      <h2 style="color:#fff; margin-bottom: var(--space-4);">Ready to start your own project?</h2>
      <p style="color:rgba(255,255,255,0.85); max-width:560px; margin-inline:auto; margin-bottom: var(--space-6);">Get in touch and let's talk about what you have in mind.</p>
      <a href="/contact" class="btn btn--light">Talk To Our Team</a>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
