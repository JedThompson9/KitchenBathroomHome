<!doctype html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<main>

  <section style="padding-top: var(--space-6);">
    <div class="container">
      <div class="breadcrumbs" style="margin-bottom: var(--space-7);">
        <a href="/">Home</a> <span>/</span>
        <a href="/gallery">Gallery</a> <span>/</span>
        <a href="/gallery/bathroom">Bathrooms</a> <span>/</span>
        <a href="/gallery/bathroom/<%= subcategory.slug %>"><%= subcategory.name %></a> <span>/</span>
        <a href="/gallery/bathroom/<%= subcategory.slug %>/<%= supplier.slug %>"><%= supplier.name %></a> <span>/</span>
        <span><%= product.name %></span>
      </div>

      <div class="about-split">
        <div class="about-split__media reveal">
          <img src="<%= product.image %>" alt="<%= product.name %>">
        </div>
        <div class="about-split__content reveal product-detail__content">
          <div class="product-detail__meta">
            <span class="product-detail__tag"><%= subcategory.name %></span>
            <span class="product-detail__tag"><%= supplier.name %></span>
          </div>
          <h1 style="margin-bottom: var(--space-4);"><%= product.name %></h1>
          <p class="lead-desc"><%= product.description %></p>
          <div class="product-detail__actions">
            <a href="/contact?product=<%= encodeURIComponent(product.name) %>&projectType=bathroom" class="btn btn--primary">Enquire About This Product</a>
            <a href="/gallery/bathroom/<%= subcategory.slug %>/<%= supplier.slug %>" class="btn btn--outline">Back To <%= supplier.name %></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-alt mt-7">
    <div class="container text-center reveal">
      <h2 style="margin-bottom: var(--space-4);">Explore more <%= subcategory.name.toLowerCase() %>.</h2>
      <p style="max-width:560px; margin-inline:auto; margin-bottom: var(--space-6);">Browse the full <%= subcategory.name.toLowerCase() %> range or head back to the bathroom gallery.</p>
      <div style="display:flex; gap: var(--space-4); justify-content:center; flex-wrap:wrap;">
        <a href="/gallery/bathroom/<%= subcategory.slug %>" class="btn btn--primary">More Suppliers</a>
        <a href="/gallery/bathroom" class="btn btn--outline">All Bathroom Categories</a>
      </div>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
