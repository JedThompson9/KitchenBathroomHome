<header class="site-header" id="siteHeader">
  <div class="container site-header__inner">
    <a href="/" class="brand">
      <img src="/images/logo-navy.png" alt="<%= site.name %>" class="brand__mark">
    </a>

    <nav class="main-nav" id="mainNav" aria-label="Primary">
      <ul class="main-nav__list">
        <li><a href="/" class="<%= currentPath === '/' ? 'is-active' : '' %>">Home</a></li>
        <li><a href="/about" class="<%= currentPath === '/about' ? 'is-active' : '' %>">About</a></li>
        <li class="has-dropdown">
          <a href="/gallery" class="<%= currentPath.startsWith('/gallery') ? 'is-active' : '' %>">Gallery</a>
          <ul class="dropdown">
            <li><a href="/gallery/kitchen">Kitchens</a></li>
            <li><a href="/gallery/bathroom">Bathrooms</a></li>
            <li><a href="/gallery/home">Home</a></li>
          </ul>
        </li>
        <li><a href="/contact" class="<%= currentPath === '/contact' ? 'is-active' : '' %>">Contact</a></li>
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href="tel:<%= site.phone.replace(/[^+\d]/g, '') %>" class="header-phone">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span><%= site.phone %></span>
      </a>
      <a href="/contact" class="btn btn--primary btn--sm">Get a Quote</a>
      <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="mainNav" aria-label="Toggle navigation menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
