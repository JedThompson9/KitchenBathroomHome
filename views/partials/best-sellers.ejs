<%
// Expects `bestSellers` (array) and `currentHref` (the base product URL for this page,
// so a product doesn't get upsold on its own page) from the calling view.
var bsItems = bestSellers.filter(function (item) { return item.href !== currentHref; });
%>
<% if (bsItems.length) { %>
<section class="section-alt mt-7">
  <div class="container">
    <div class="carousel-header">
      <div class="section-head">
        <span class="eyebrow">You Might Also Like</span>
        <h2>Best Sellers</h2>
      </div>
      <div class="carousel-controls">
        <button type="button" class="carousel__btn carousel__btn--prev" data-carousel-prev aria-label="Previous best sellers" disabled>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="carousel__btn carousel__btn--next" data-carousel-next aria-label="Next best sellers">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <div class="carousel" data-carousel>
      <div class="carousel__track" data-carousel-track>
        <% bsItems.forEach(function(item) { %>
        <a href="<%= item.href %>" class="card product-card carousel__item">
          <div class="product-card__media">
            <img src="<%= item.image %>" alt="<%= item.name %>" loading="lazy">
          </div>
          <div class="product-card__body">
            <span class="project-card__tag"><%= item.subcategoryName %></span>
            <h3><%= item.name %></h3>
            <p><%= item.description %></p>
          </div>
        </a>
        <% }); %>
      </div>
    </div>
  </div>
</section>
<% } %>
