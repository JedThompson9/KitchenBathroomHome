<!doctype html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<main>

  <section class="page-banner">
    <div class="page-banner__bg">
      <img src="<%= categories.bathroom.heroImage %>" alt="Gallery of bathroom, kitchen and home renovations">
    </div>
    <div class="container">
      <div class="page-banner__content">
        <div class="breadcrumbs"><a href="/">Home</a> <span>/</span> <span>Gallery</span></div>
        <h1>Our Renovation Gallery</h1>
        <p>Browse real bathrooms, kitchens and home spaces we've designed and built across Brisbane.</p>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head center">
        <span class="eyebrow">Explore By Category</span>
        <h2>Three spaces. One standard of craftsmanship.</h2>
      </div>
      <div class="category-grid reveal-stagger">
        <% Object.values(categories).forEach(function(cat) { %>
        <a href="/gallery/<%= cat.slug %>" class="category-card">
          <img src="<%= cat.heroImage %>" alt="<%= cat.name %> gallery" loading="lazy">
          <div class="category-card__body">
            <span class="count"><%= cat.slug === 'bathroom' ? bathroomSubcategoryCount + ' Categories' : cat.products.length + ' Projects' %></span>
            <h3><%= cat.name %></h3>
            <p><%= cat.tagline %></p>
            <span class="category-card__link">View Gallery
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </div>
        </a>
        <% }); %>
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="container text-center reveal">
      <h2 style="margin-bottom: var(--space-4);">Can't find exactly what you're after?</h2>
      <p style="max-width:560px; margin-inline:auto; margin-bottom: var(--space-6);">Every project we build is custom. Get in touch and let's talk about what you have in mind.</p>
      <a href="/contact" class="btn btn--primary">Talk To Our Team</a>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
