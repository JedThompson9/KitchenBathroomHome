<!doctype html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<main>

  <section class="page-banner" style="min-height:260px;">
    <div class="page-banner__bg">
      <img src="<%= product.image %>" alt="<%= product.name %>">
    </div>
    <div class="container">
      <div class="page-banner__content">
        <div class="breadcrumbs">
          <a href="/">Home</a> <span>/</span>
          <a href="/gallery">Gallery</a> <span>/</span>
          <a href="/gallery/bathroom">Bathrooms</a> <span>/</span>
          <a href="/gallery/bathroom/<%= subcategory.slug %>"><%= subcategory.name %></a> <span>/</span>
          <a href="/gallery/bathroom/<%= subcategory.slug %>/<%= supplier.slug %>"><%= supplier.name %></a> <span>/</span>
          <span><%= product.name %></span>
        </div>
        <h1><%= product.name %></h1>
        <p><%= product.description %></p>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head">
        <span class="eyebrow"><%= supplier.name %></span>
        <h2>Choose a size &amp; finish.</h2>
      </div>

      <div class="photo-grid reveal-stagger">
        <% product.variants.forEach(function(variant) { %>
        <a href="/gallery/bathroom/<%= subcategory.slug %>/<%= supplier.slug %>/<%= product.slug %>/<%= variant.slug %>" class="photo-grid-item">
          <div class="photo-grid-item__media">
            <img src="<%= variant.image %>" alt="<%= variant.name %>" loading="lazy">
          </div>
          <span class="photo-grid-item__name"><%= variant.name %></span>
          <% if (variant.code) { %><span class="photo-grid-item__code"><%= variant.code %></span><% } %>
        </a>
        <% }); %>
      </div>
    </div>
  </section>

  <section class="section-primary">
    <div class="container text-center reveal">
      <h2 style="color:#fff; margin-bottom: var(--space-4);">Not sure which size is right?</h2>
      <p style="color:rgba(255,255,255,0.85); max-width:560px; margin-inline:auto; margin-bottom: var(--space-6);">Get in touch and we'll help you measure up and choose the right fit.</p>
      <a href="/contact" class="btn btn--light">Talk To Our Team</a>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
