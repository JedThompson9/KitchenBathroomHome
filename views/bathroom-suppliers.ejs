<!doctype html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<%
function initials(name) {
  return name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
}
%>

<main>

  <section class="page-banner" style="min-height:260px;">
    <div class="page-banner__bg">
      <img src="<%= subcategory.image %>" alt="<%= subcategory.name %>">
    </div>
    <div class="container">
      <div class="page-banner__content">
        <div class="breadcrumbs"><a href="/">Home</a> <span>/</span> <a href="/gallery">Gallery</a> <span>/</span> <a href="/gallery/bathroom">Bathrooms</a> <span>/</span> <span><%= subcategory.name %></span></div>
        <h1><%= subcategory.name %></h1>
        <p><%= subcategory.tagline %></p>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Suppliers</span>
        <h2>Choose a supplier to browse their <%= subcategory.name.toLowerCase() %> range.</h2>
      </div>

      <div class="supplier-grid reveal-stagger">
        <% subcategory.suppliers.forEach(function(supplier) { %>
        <a href="/gallery/bathroom/<%= subcategory.slug %>/<%= supplier.slug %>" class="card supplier-card">
          <div class="supplier-card__header">
            <% if (supplier.logo) { %>
              <img src="<%= supplier.logo %>" alt="<%= supplier.name %> logo" class="supplier-card__logo">
            <% } else { %>
              <span class="supplier-avatar"><%= initials(supplier.name) %></span>
            <% } %>
            <h3><%= supplier.name %></h3>
            <span class="supplier-card__count"><%= supplier.products.length %> product<%= supplier.products.length === 1 ? '' : 's' %></span>
          </div>
          <p class="blurb"><%= supplier.blurb %></p>
          <div class="supplier-card__footer">
            <span class="supplier-card__link">View Products
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </div>
        </a>
        <% }); %>
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="container text-center reveal">
      <h2 style="margin-bottom: var(--space-4);">Need help choosing?</h2>
      <p style="max-width:560px; margin-inline:auto; margin-bottom: var(--space-6);">Our team can talk you through the options and help you find the right fit and finish.</p>
      <a href="/contact" class="btn btn--primary">Talk To Our Team</a>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
