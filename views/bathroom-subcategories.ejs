<!doctype html>
<html lang="en">
<head>
<%- include('partials/head') %>
</head>
<body>
<%- include('partials/header') %>

<main>

  <section class="page-banner">
    <div class="page-banner__bg">
      <img src="<%= category.heroImage %>" alt="Bathrooms gallery">
    </div>
    <div class="container">
      <div class="page-banner__content">
        <div class="breadcrumbs"><a href="/">Home</a> <span>/</span> <a href="/gallery">Gallery</a> <span>/</span> <span>Bathrooms</span></div>
        <h1>Bathrooms Gallery</h1>
        <p><%= category.tagline %></p>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="category-pills">
        <a href="/gallery/bathroom" class="category-pill is-active">Bathrooms</a>
        <a href="/gallery/kitchen" class="category-pill">Kitchens</a>
        <a href="/gallery/home" class="category-pill">Home</a>
      </div>

      <div class="section-head">
        <span class="eyebrow">Shop By Category</span>
        <h2>Find exactly what your bathroom needs.</h2>
      </div>

      <div class="subcategory-grid reveal-stagger">
        <% subcategories.forEach(function(sub) { %>
        <a href="/gallery/bathroom/<%= sub.slug %>" class="subcategory-card">
          <img src="<%= sub.image %>" alt="<%= sub.name %>" loading="lazy">
          <div class="subcategory-card__body">
            <span class="count"><%= sub.suppliers.length %> Supplier<%= sub.suppliers.length === 1 ? '' : 's' %></span>
            <h3><%= sub.name %></h3>
          </div>
        </a>
        <% }); %>
      </div>
    </div>
  </section>

  <section class="section-primary">
    <div class="container text-center reveal">
      <h2 style="color:#fff; margin-bottom: var(--space-4);">Can't find what you're looking for?</h2>
      <p style="color:rgba(255,255,255,0.85); max-width:560px; margin-inline:auto; margin-bottom: var(--space-6);">Get in touch and we'll help track down the right product for your renovation.</p>
      <a href="/contact" class="btn btn--light">Talk To Our Team</a>
    </div>
  </section>

</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
